{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ieadpg-d1",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ieadpg-db",
      "database_id": "359e34dc-a34b-4148-8f30-c44d679f3247"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OTP_KV",
      "id": "a42667d43a94407baf83582b93379eb7"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WHATSAPP_QUEUE",
        "queue": "ieadpg-whatsapp-queue"
      }
    ],
    "consumers": [
      {
        "queue": "ieadpg-whatsapp-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "vars": {
    "WHATSAPP_GATEWAY_URL": "https://mail.ieadpg.org/whatsapp"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
